#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    chosen {
        zmk,matrix-transform = &five_column_transform;
    };

    behaviors {
        /*
         * Home-row modifiers
         * Hold = modifier
         * Tap  = normal key
         */
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        /*
         * Layer-tap for Space/Tab
         */
        lt_spc: layer_tap_space {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_SPACE";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            flavor = "tap-preferred";
            bindings = <&mo>, <&kp>;
        };

        /*
         * Balanced layer-tap for thumb keys
         */
        lt_bal: layer_tap_balanced {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_BALANCED";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            flavor = "balanced";
            bindings = <&mo>, <&kp>;
        };

        /*
         * Hold = Nav layer
         * Tap  = Caps Word
         */
        ht_caps: hold_tap_caps_word {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_TAP_CAPS_WORD";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            flavor = "balanced";
            bindings = <&mo>, <&caps_wrap>;
        };
    };

    macros {
        caps_wrap: caps_wrap {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&caps_word>;
        };
    };

    combos {
        compatible = "zmk,combos";

        /*
         * Press the two outermost thumb keys together
         * to access the Bluetooth layer.
         */
        combo_bt_layer {
            timeout-ms = <50>;
            key-positions = <30 35>;
            bindings = <&mo 4>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /*
         * Layer 0: Linux / Arch
         *
         * This is exactly your current working Linux layout.
         */
        linux_layer {
            bindings = <
            &kp Q        &kp W        &kp E        &kp R         &kp T           &kp Y        &kp U         &kp I       &kp O        &kp P
            &hm LGUI A   &hm LALT S   &hm LCTRL D  &hm LSHFT F   &kp G           &kp H        &hm RSHFT J   &hm RCTRL K  &hm RALT L   &hm RGUI SEMI
            &kp Z        &kp X        &kp C        &kp V         &kp B           &kp N        &kp M         &kp COMMA   &kp DOT      &kp FSLH
                                      &lt_bal 1 ESC &lt_bal 2 BSPC &lt_spc 3 TAB &lt_spc 3 SPACE &lt_bal 2 RET &ht_caps 1 0
            >;
        };

        /*
         * Layer 1: Navigation
         */
        nav_layer {
            bindings = <
            &kp C_BRI_DN &kp C_BRI_UP &none       &none         &kp C_PREV      &kp C_PP     &kp C_NEXT    &kp C_MUTE  &kp C_VOL_DN &kp C_VOL_UP
            &trans       &trans       &trans       &trans        &trans          &kp LEFT     &kp DOWN      &kp UP      &kp RIGHT    &trans
            &kp DEL      &kp END      &kp PG_UP    &kp PG_DN     &kp HOME        &kp HOME     &kp PG_DN     &kp PG_UP   &kp END      &kp DEL
                                      &trans       &trans        &trans          &trans       &trans        &trans
            >;
        };

        /*
         * Layer 2: Symbols
         */
        sym_layer {
            bindings = <
            &kp MINUS    &kp CARET    &kp LBKT    &kp RBKT      &kp EXCL        &kp PRCNT    &kp DLLR      &kp AT      &kp STAR     &kp HASH
            &kp GRAVE    &kp PLUS     &kp LPAR    &kp RPAR      &kp SQT         &kp DQT      &kp LBRC      &kp RBRC    &kp UNDER    &kp EQUAL
            &none        &none        &none       &kp AMPS      &kp PIPE        &kp BSLH     &kp TILDE     &none       &none        &none
                                      &none       &none         &none           &none        &none         &none
            >;
        };

        /*
         * Layer 3: Numbers / Function keys
         */
        num_layer {
            bindings = <
            &kp N1       &kp N2       &kp N3      &kp N4        &kp N5          &kp N6       &kp N7        &kp N8      &kp N9       &kp N0
            &trans       &trans       &trans       &trans        &kp F11         &kp F12      &none         &none       &none        &none
            &kp F1       &kp F2       &kp F3      &kp F4        &kp F5          &kp F6       &kp F7        &kp F8      &kp F9       &kp F10
                                      &trans      &trans        &trans          &trans       &trans        &trans
            >;
        };

        /*
         * Layer 4: Bluetooth
         *
         * All five profiles now use the same Linux keymap.
         * Selecting a Bluetooth profile no longer changes
         * the base layer.
         */
        bt_layer {
            bindings = <
            &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4    &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4
            &none        &none        &none        &none        &none           &none        &none        &none        &none        &bt BT_CLR
            &none        &none        &none        &none        &none           &none        &none        &none        &out OUT_TOG &none
                                      &none        &none        &none           &none        &none        &none
            >;
        };
    };
};
